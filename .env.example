# Copy to .env at the repo root before kicking off implementation; P0-1 copies it to frontend/.env
DB_URL=postgres://user:password@host:5432/autoapps
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=                      # openssl rand -base64 32 (the executor generates it if empty)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# The two Google test accounts used in the demo; the seed script writes them into fixture sheets
DEMO_BUILDER_EMAIL=
DEMO_CONSUMER_EMAIL=
NEBIUS_API_KEY=
NEBIUS_MODEL=zai-org/GLM-5.3
NEBIUS_MODEL_SUGGEST=zai-org/GLM-5.3-Flash
NEBIUS_REASONING_EFFORT=high
# Optional, only for invite emails
SES_FROM_EMAIL=
AWS_REGION=us-west-2
